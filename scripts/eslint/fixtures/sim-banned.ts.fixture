// Lint fixture (PLAN §14): every line here must trip the determinism lint
// when placed under src/core/sim/. It is never compiled or bundled.
export function banned(x: number): number {
  const a = Math.sin(x);
  const b = Math.pow(x, 2);
  const c = x ** 3;
  const d = Date.now();
  const e = performance.now();
  const f = Math.random();
  const g = Math.hypot(x, x) + Math.atan2(x, 1);
  return a + b + c + d + e + f + g;
}
