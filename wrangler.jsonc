{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roslambo",
  "compatibility_date": "2026-10-24",
  // Assets only: no "main", so no Worker script ever runs (PLAN D-25).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  // Request logs would keep visitor IP addresses (C-21).
  "observability": { "enabled": false },
  // Served at roslambo.<account subdomain>.workers.dev until the domain is
  // chosen (Q-9); "routes" then adds it.
  "workers_dev": true
}
